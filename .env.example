# Prefer: python scripts/configure_env.py (generates unique credentials).
# If copying manually, replace BOTH values before starting Compose.
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
RS_SECRET_KEY=replace-with-a-random-secret
RS_ENV=dev
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
API_BIND=127.0.0.1
API_PORT=8000
RS_PUBLIC_BASE_URL=http://localhost:8080
RS_CORS_ORIGINS=http://localhost:8080,http://localhost:5173
RS_BACKUP_INTERVAL_MIN=30
RS_BACKUP_KEEP=48
