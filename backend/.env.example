# Скопируйте в backend/.env (для локальной разработки без Docker URL БД
# подставляет scripts/run_dev.py, переменную можно не задавать).
RS_ENV=dev
RS_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/regsys
RS_SECRET_KEY=dev-secret-change-me
RS_CORS_ORIGINS=http://localhost:5173
# Вебхук Битрикс24 (секрет, только из окружения; через API не передаётся)
# RS_BITRIX_WEBHOOK_URL=https://<портал>.bitrix24.ru/rest/<user>/<token>/
